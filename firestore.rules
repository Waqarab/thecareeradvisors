rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Admin is super admin OR someone with the 'admin' custom claim
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'superadmintcagroup786@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (request.auth != null && request.auth.token.admin == true);
    }

    function hasWriteAccess() {
      return isSuperAdmin() || (request.auth != null && request.auth.token.admin == true && request.auth.token.canWrite == true);
    }

    // 1. Universities, Colleges & Testimonials
    // Public reads are restricted to published documents (isHidden != true).
    // The public client query must include: where("isHidden", "==", false).
    // Admin reads bypass this via isAdmin() and can access drafts.
    match /universities/{uniId} {
      allow read: if isAdmin() || (resource != null && resource.data.isHidden == false);
      allow write: if hasWriteAccess();
    }
    match /recycled_universities/{uniId} {
      allow read: if isAdmin();
      allow write: if hasWriteAccess();
    }
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if hasWriteAccess();
    }
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if hasWriteAccess();
    }

    // 2. Notifications
    // Strict match: isActive must explicitly equal true
    match /notifications/{notificationId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if hasWriteAccess();
    }

    // 3. CRM Inquiries
    match /inquiries/{inquiryId} {
      allow create: if false;

      allow read: if isAdmin();
      allow update, delete: if hasWriteAccess();
    }
    
    match /recycled_inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow write: if hasWriteAccess();
    }

    // 4. FCM Tokens
    match /fcm_tokens/{tokenId} {
      // Closed because no client currently writes to it. 
      // Must be reopened with validation when push notification registration is implemented.
      allow create, update: if false; 
      allow read: if isAdmin();
      allow delete: if hasWriteAccess();
    }

    // 5. Global Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
